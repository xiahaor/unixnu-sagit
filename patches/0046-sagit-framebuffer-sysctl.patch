--- /dev/null
+++ b/bsd/kern/sagit_fb.c
@@ -0,0 +1,183 @@
+/*
+ * sagit_fb.c - minimal userspace framebuffer access for the sagit bring-up.
+ *
+ * The in-kernel video console already maps the scanout and keeps its
+ * geometry in the global "vinfo" (osfmk/console/video_console.c). This file
+ * exposes a tiny write-only sysctl (kern.sagitfb) that fills one rectangle
+ * into that scanout, so userspace can prove it can drive graphics without
+ * needing a full IOKit framebuffer driver.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <sys/kernel.h>
+#include <sys/malloc.h>
+#include <console/video_console.h>
+#include <kern/thread.h>
+
+extern struct vc_info vinfo;
+
+struct sagit_fb_req {
+	uint32_t x;
+	uint32_t y;
+	uint32_t w;
+	uint32_t h;
+	uint32_t color;		/* 0x00RRGGBB, written as a 32-bit XRGB pixel */
+};
+
+/*
+ * Return-to-user probe: called from arm64_thread_exception_return with the
+ * saved user state. It only records samples in a global ring buffer; printing
+ * from the return path is unsafe, so userspace reads the buffer later.
+ */
+struct sagit_probe_sample {
+	uint64_t pc;
+	uint64_t sp;
+	uint64_t cpsr;
+	uint64_t tid;
+};
+
+struct sagit_probe_report {
+	uint32_t count;
+	uint32_t armed;
+	uint32_t bootstrap_count;
+	uint32_t reserved;
+	uint64_t bootstrap_tids[8];
+	struct sagit_probe_sample samples[16];
+	uint64_t mach_abs;
+};
+
+int sagit_probe_user_armed;
+static struct sagit_probe_report sagit_probe_report;
+
+void
+sagit_probe_bootstrap(void)
+{
+	uint32_t n = sagit_probe_report.bootstrap_count;
+
+	if (!sagit_probe_user_armed || n >= 8) {
+		return;
+	}
+	sagit_probe_report.bootstrap_tids[n] = thread_tid(current_thread());
+	sagit_probe_report.bootstrap_count = n + 1;
+}
+
+void
+sagit_probe_user_return(void *state)
+{
+	uint64_t *s = (uint64_t *)state;
+	uint32_t n;
+
+	if (!sagit_probe_user_armed) {
+		return;
+	}
+	n = sagit_probe_report.count;
+	if (n >= 16) {
+		return;
+	}
+	sagit_probe_report.samples[n].pc = s[32];
+	sagit_probe_report.samples[n].sp = s[31];
+	sagit_probe_report.samples[n].cpsr = s[33];
+	sagit_probe_report.samples[n].tid = thread_tid(current_thread());
+	sagit_probe_report.count = n + 1;
+}
+
+static int
+sagit_probe_report_get SYSCTL_HANDLER_ARGS
+{
+	int err;
+
+	(void)oidp;
+	(void)arg1;
+	(void)arg2;
+	sagit_probe_report.armed = sagit_probe_user_armed ? 1 : 0;
+	sagit_probe_report.mach_abs = mach_absolute_time();
+	err = SYSCTL_OUT(req, &sagit_probe_report, sizeof(sagit_probe_report));
+	return err;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sagitfbreport,
+    CTLTYPE_STRUCT | CTLFLAG_RD,
+    0, 0, sagit_probe_report_get, "S,sagit_probe_report",
+    "read the return-to-user probe samples (bring-up test)");
+
+static int
+sagit_fb_fill SYSCTL_HANDLER_ARGS
+{
+	struct sagit_fb_req r;
+	uint32_t *base;
+	uint32_t x, y, stride_px;
+	int err;
+
+	(void)oidp;
+	(void)arg1;
+	(void)arg2;
+
+	err = SYSCTL_IN(req, &r, sizeof(r));
+	if (err) {
+		return err;
+	}
+	/* Magic request from userspace: arm the return-to-user probe. */
+	if (r.color == 0x00A2B1E3 && r.x == 0x5A617469) {
+		sagit_probe_user_armed = 1;
+		sagit_probe_report.count = 0;
+		sagit_probe_report.bootstrap_count = 0;
+		return 0;
+	}
+
+	if (vinfo.v_baseaddr == 0 || vinfo.v_depth != 32 || vinfo.v_rowbytes == 0) {
+		return ENODEV;
+	}
+	if (r.x >= vinfo.v_width || r.y >= vinfo.v_height ||
+	    r.w == 0 || r.h == 0 ||
+	    r.w > vinfo.v_width - r.x || r.h > vinfo.v_height - r.y) {
+		return EINVAL;
+	}
+
+	base = (uint32_t *)vinfo.v_baseaddr;
+	stride_px = vinfo.v_rowbytes / sizeof(uint32_t);
+	for (y = 0; y < r.h; y++) {
+		uint32_t *row = base + (r.y + y) * stride_px + r.x;
+		for (x = 0; x < r.w; x++) {
+			row[x] = r.color;
+		}
+	}
+	return 0;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sagitfb,
+    CTLTYPE_STRUCT | CTLFLAG_WR,
+    0, 0, sagit_fb_fill, "S,sagit_fb_req",
+    "fill one framebuffer rectangle (bring-up test)");
+
+struct sagit_fb_info {
+	uint32_t width;
+	uint32_t height;
+	uint32_t depth;
+	uint32_t rowbytes;
+	uint64_t physaddr;
+};
+
+static int
+sagit_fb_info_get SYSCTL_HANDLER_ARGS
+{
+	struct sagit_fb_info info;
+	int err;
+
+	(void)oidp;
+	(void)arg1;
+	(void)arg2;
+
+	info.width = vinfo.v_width;
+	info.height = vinfo.v_height;
+	info.depth = vinfo.v_depth;
+	info.rowbytes = vinfo.v_rowbytes;
+	info.physaddr = vinfo.v_physaddr;
+	err = SYSCTL_OUT(req, &info, sizeof(info));
+	return err;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sagitfbinfo,
+    CTLTYPE_STRUCT | CTLFLAG_RD,
+    0, 0, sagit_fb_info_get, "S,sagit_fb_info",
+    "query video console framebuffer geometry (bring-up test)");
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -404,6 +404,7 @@
 bsd/kern/kern_subr.c			standard
 bsd/kern/kern_synch.c			standard
 bsd/kern/kern_sysctl.c			standard
+bsd/kern/sagit_fb.c			standard
 bsd/kern/kern_newsysctl.c		standard
 bsd/kern/kern_memorystatus.c	optional config_memorystatus
 bsd/kern/kern_memorystatus_freeze.c	optional config_memorystatus
