--- /dev/null
+++ b/osfmk/arm64/sdm835_gic.c
@@ -0,0 +1,283 @@
+/*
+ * pe_msm8998.c - minimal non-secure GICv3 + EL1 virtual timer bring-up.
+ *
+ * The kernel is built with ARM64_BOARD_CONFIG_BCM2837, whose interrupt path
+ * expects the Raspberry Pi local controller. On the real MSM8998 hardware the
+ * timer interrupt arrives as a normal GICv3 Group1 IRQ (Qualcomm routes the
+ * virtual timer PPI at INTID 19), so this file maps the Qualcomm GIC, enables
+ * only that PPI and SGI 0, and dispatches the IRQ path to rtclock_intr().
+ *
+ * Reference: MC-XiaoXiao/ios_sagit osfmk/arm64/sdm835.c (validated values:
+ * GICD 0x17a00000, GICR 0x17b00000/1 MiB, 19.2 MHz, VTIMER INTID 19, SGI 0).
+ */
+#include <stdint.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/arm64/board_config.h>
+#include <kern/clock.h>
+#include <arm/cpu_data.h>
+#include <arm/cpu_data_internal.h>
+#include <arm/misc_protos.h>
+#include <arm/rtclock.h>
+#include <arm/machine_cpu.h>
+#include <arm64/proc_reg.h>
+
+#define MSM8998_GICD_BASE   0x17a00000ULL
+#define MSM8998_GICD_SIZE   0x10000ULL
+#define MSM8998_GICR_BASE   0x17b00000ULL
+#define MSM8998_GICR_SIZE   0x100000ULL
+#define MSM8998_GICR_STRIDE 0x20000ULL
+#define MSM8998_TIMER_HZ    19200000ULL
+#define MSM8998_VTIMER_INTID 19
+#define MSM8998_VTIMER_INTID_ALT 27
+#define MSM8998_IPI_INTID   0
+
+/* Distributor */
+#define GICD_CTLR        0x0000
+#define GICD_CTLR_ARE_NS 0x10
+#define GICD_CTLR_GRP1NS 0x02
+/* Redistributor, RD_base */
+#define GICR_CTLR        0x0000
+#define GICR_TYPER       0x0008
+#define GICR_WAKER       0x0014
+#define GICR_WAKER_SLEEP 0x2
+#define GICR_WAKER_ASLEEP 0x4
+/* Redistributor, SGI_base */
+#define GICR_SGI_BASE    0x10000
+#define GICR_IGROUPR0    0x0080
+#define GICR_ISENABLER0  0x0100
+#define GICR_ICENABLER0  0x0180
+#define GICR_ICPENDR0    0x0280
+#define GICR_ICACTIVER0  0x0380
+#define GICR_IPRIORITYR0 0x0400
+#define GICR_ICFGR1      0x0c04
+
+#define GIC_SPURIOUS_ID_START 1020
+#define GIC_CPU_MASK 0xffffffULL
+
+static vm_offset_t msm8998_gicd;
+static vm_offset_t msm8998_gicr_pe;
+static boolean_t msm8998_ready;
+
+static inline uint32_t
+msm8998_rd32(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static inline uint64_t
+msm8998_rd64(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint64_t *)(base + off);
+}
+
+static inline void
+msm8998_wr32(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(base + off) = value;
+	__builtin_arm_dsb(DSB_SY);
+}
+
+static uint32_t
+msm8998_affinity(void)
+{
+	return (uint32_t)(__builtin_arm_rsr64("MPIDR_EL1") & 0xffffffULL);
+}
+
+/* Find this CPU's redistributor frame by affinity (GICv3 GICR_TYPER). */
+static vm_offset_t
+msm8998_find_gicr(vm_offset_t gicr_base, uint32_t affinity)
+{
+	for (vm_offset_t off = 0; off < MSM8998_GICR_SIZE; off += MSM8998_GICR_STRIDE) {
+		uint64_t typer = msm8998_rd64(gicr_base, off + GICR_TYPER);
+		uint32_t aff = (uint32_t)(typer >> 32) & 0xffffffU;
+		if (aff == affinity) {
+			return gicr_base + off;
+		}
+		if (typer & 0x10) { /* Last */
+			break;
+		}
+	}
+	return 0;
+}
+
+static void
+msm8998_enable_local_interrupts(void)
+{
+	uint32_t mask = (1U << MSM8998_VTIMER_INTID) |
+	    (1U << MSM8998_VTIMER_INTID_ALT) | (1U << MSM8998_IPI_INTID);
+	vm_offset_t sgi = msm8998_gicr_pe + GICR_SGI_BASE;
+	uint32_t ctlr, value, off, shift;
+
+	/* Wake the redistributor. */
+	value = msm8998_rd32(msm8998_gicr_pe, GICR_WAKER);
+	msm8998_wr32(msm8998_gicr_pe, GICR_WAKER, value & ~GICR_WAKER_SLEEP);
+	for (int i = 0; i < 1000000; i++) {
+		if ((msm8998_rd32(msm8998_gicr_pe, GICR_WAKER) & GICR_WAKER_ASLEEP) == 0) {
+			break;
+		}
+		__asm__ volatile("yield");
+	}
+
+	/* Clean any firmware state, then enable only our two PPIs. */
+	msm8998_wr32(sgi, GICR_ICENABLER0, mask);
+	msm8998_wr32(sgi, GICR_ICPENDR0, mask);
+	msm8998_wr32(sgi, GICR_ICACTIVER0, mask);
+
+	ctlr = msm8998_rd32(msm8998_gicd, GICD_CTLR);
+	printf("sagit gic: GICD_CTLR=0x%x\n", ctlr);
+	if ((ctlr & GICD_CTLR_ARE_NS) == 0) {
+		printf("sagit gic: affinity routing (ARE_NS) not enabled by firmware\n");
+	}
+	msm8998_wr32(msm8998_gicd, GICD_CTLR, ctlr | GICD_CTLR_GRP1NS | GICD_CTLR_ARE_NS);
+	msm8998_wr32(msm8998_gicd, GICD_CTLR,
+	    msm8998_rd32(msm8998_gicd, GICD_CTLR) | GICD_CTLR_GRP1NS);
+
+	/* Group1 for timer and IPI when the distributor is not in DS mode. */
+	if ((ctlr & 0x40) != 0) { /* DS=1: IGROUPR writable */
+		value = msm8998_rd32(sgi, GICR_IGROUPR0);
+		msm8998_wr32(sgi, GICR_IGROUPR0, value | mask);
+	}
+
+	/* Priority 0x80 for both, virtual timer stays level-sensitive. */
+	off = GICR_IPRIORITYR0 + (MSM8998_VTIMER_INTID & ~3U);
+	shift = (MSM8998_VTIMER_INTID & 3) * 8;
+	value = msm8998_rd32(sgi, off);
+	msm8998_wr32(sgi, off, (value & ~(0xffU << shift)) | (0x80U << shift));
+	off = GICR_IPRIORITYR0 + (MSM8998_VTIMER_INTID_ALT & ~3U);
+	shift = (MSM8998_VTIMER_INTID_ALT & 3) * 8;
+	value = msm8998_rd32(sgi, off);
+	msm8998_wr32(sgi, off, (value & ~(0xffU << shift)) | (0x80U << shift));
+	off = GICR_IPRIORITYR0 + (MSM8998_IPI_INTID & ~3U);
+	shift = (MSM8998_IPI_INTID & 3) * 8;
+	value = msm8998_rd32(sgi, off);
+	msm8998_wr32(sgi, off, (value & ~(0xffU << shift)) | (0x80U << shift));
+
+	for (unsigned int t = 0; t < 2; t++) {
+		unsigned int tid = t ? MSM8998_VTIMER_INTID_ALT : MSM8998_VTIMER_INTID;
+		off = GICR_ICFGR1 + ((tid - 16) / 4) * 4;
+		shift = ((tid - 16) & 3) * 2;
+		value = msm8998_rd32(sgi, off);
+		value &= ~(3U << shift);
+		value |= (2U << shift); /* level */
+		msm8998_wr32(sgi, off, value);
+	}
+
+	msm8998_wr32(sgi, GICR_ISENABLER0, mask);
+	for (int i = 0; i < 1000000; i++) {
+		if ((msm8998_rd32(sgi, GICR_ISENABLER0) & mask) == mask) {
+			break;
+		}
+		__asm__ volatile("yield");
+	}
+	printf("sagit gic: ISENABLER0=0x%x IGROUPR0=0x%x ICFGR1=0x%x\n",
+	    msm8998_rd32(sgi, GICR_ISENABLER0), msm8998_rd32(sgi, GICR_IGROUPR0),
+	    msm8998_rd32(sgi, GICR_ICFGR1));
+}
+
+void
+pe_msm8998_init_interrupts(void)
+{
+	if (msm8998_ready) {
+		return;
+	}
+	msm8998_gicd = ml_io_map(MSM8998_GICD_BASE, MSM8998_GICD_SIZE);
+	vm_offset_t gicr = ml_io_map(MSM8998_GICR_BASE, MSM8998_GICR_SIZE);
+	if (!msm8998_gicd || !gicr) {
+		printf("sagit gic: cannot map GIC registers (gicd=%lu gicr=%lu)\n",
+		    (unsigned long)msm8998_gicd, (unsigned long)gicr);
+		return;
+	}
+	uint32_t affinity = msm8998_affinity();
+	msm8998_gicr_pe = msm8998_find_gicr(gicr, affinity);
+	printf("sagit gic: affinity=0x%x gicr_pe=0x%lx\n", affinity,
+	    (unsigned long)msm8998_gicr_pe);
+	if (!msm8998_gicr_pe) {
+		return;
+	}
+
+	/* GICv3 system register interface. */
+	__builtin_arm_wsr64("ICC_SRE_EL1", __builtin_arm_rsr64("ICC_SRE_EL1") | 1);
+	__builtin_arm_isb(ISB_SY);
+	if ((__builtin_arm_rsr64("ICC_SRE_EL1") & 1) == 0) {
+		printf("sagit gic: firmware forbids GIC system registers\n");
+		return;
+	}
+	__builtin_arm_wsr64("ICC_IGRPEN1_EL1", 0);
+	__builtin_arm_isb(ISB_SY);
+	__builtin_arm_wsr64("ICC_PMR_EL1", 0xff);
+	__builtin_arm_wsr64("ICC_BPR1_EL1", 0);
+	__builtin_arm_wsr64("ICC_CTLR_EL1", __builtin_arm_rsr64("ICC_CTLR_EL1") & ~2ULL);
+	__builtin_arm_wsr64("ICC_IGRPEN1_EL1", 1);
+	__builtin_arm_isb(ISB_SY);
+
+	msm8998_enable_local_interrupts();
+
+	/* MSM8998's counter runs at 19.2 MHz; make mach time consistent. */
+	gPEClockFrequencyInfo.timebase_frequency_hz = MSM8998_TIMER_HZ;
+	gPEClockFrequencyInfo.dec_clock_rate_hz = MSM8998_TIMER_HZ;
+
+	msm8998_ready = TRUE;
+	printf("sagit gic: interrupt controller initialized (timer INTID %u)\n",
+	    MSM8998_VTIMER_INTID);
+}
+
+void
+pe_msm8998_handle_irq(void)
+{
+	uint64_t iar;
+	unsigned int id;
+
+	if (!msm8998_ready) {
+		return;
+	}
+	iar = __builtin_arm_rsr64("ICC_IAR1_EL1");
+	id = (unsigned int)(iar & GIC_CPU_MASK);
+	if (id >= GIC_SPURIOUS_ID_START) {
+		return;
+	}
+	if (id == MSM8998_VTIMER_INTID || id == MSM8998_VTIMER_INTID_ALT) {
+		getCpuDatap()->cpu_decrementer = -1;
+		rtclock_intr(TRUE);
+	} else if (id == MSM8998_IPI_INTID) {
+		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+		__builtin_arm_isb(ISB_SY);
+		cpu_signal_handler();
+		return;
+	} else {
+		printf("sagit gic: unexpected IRQ %u\n", id);
+	}
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+	__builtin_arm_isb(ISB_SY);
+}
+
+/* Local (sagit): called from the kern.sagitfb sysctl so the bring-up test can
+ * (re)initialize the controller once the video console is up and print state. */
+int
+pe_msm8998_gic_force_init(void)
+{
+	msm8998_ready = FALSE;
+	pe_msm8998_init_interrupts();
+	return msm8998_ready ? 0 : 1;
+}
+
+void
+pe_msm8998_gic_report(void)
+{
+	if (!msm8998_gicr_pe) {
+		printf("sagit gic report: not mapped\n");
+		return;
+	}
+	vm_offset_t sgi = msm8998_gicr_pe + GICR_SGI_BASE;
+	printf("sagit gic report: ready=%d gicd_ctlr=0x%x ISENABLER0=0x%x IGROUPR0=0x%x ICFGR1=0x%x\n",
+	    msm8998_ready, msm8998_rd32(msm8998_gicd, GICD_CTLR),
+	    msm8998_rd32(sgi, GICR_ISENABLER0), msm8998_rd32(sgi, GICR_IGROUPR0),
+	    msm8998_rd32(sgi, GICR_ICFGR1));
+	printf("sagit gic report: IGRPEN1=%llu PMR=%llu CTLR=%llu CNTV_CTL=%llu CNTV_TVAL=%llu\n",
+	    (unsigned long long)__builtin_arm_rsr64("ICC_IGRPEN1_EL1"),
+	    (unsigned long long)__builtin_arm_rsr64("ICC_PMR_EL1"),
+	    (unsigned long long)__builtin_arm_rsr64("ICC_CTLR_EL1"),
+	    (unsigned long long)__builtin_arm_rsr64("CNTV_CTL_EL0"),
+	    (unsigned long long)__builtin_arm_rsr64("CNTV_TVAL_EL0"));
+}
